# Salin ke .env.local. Semua opsional: tanpa DATABASE_URL aplikasi berjalan di mode demo (memori).
DATABASE_URL=postgres://lesin:lesin@localhost:5432/lesin
# SESSION_SECRET=string-acak-panjang
# PAYMENT_WEBHOOK_SECRET=string-acak-panjang
# ALLOW_PAYMENT_SIMULATION=true
# SEED_DEMO_DATA=true
# RESEND_API_KEY=re_xxx            # kirim OTP email sungguhan (resend.com). Kosong = mode demo: kode tampil di layar
# EMAIL_FROM=LesIn <halo@domainmu.id>
# PAYMENT_MODE=manual              # QRIS statis + konfirmasi admin (tanpa payment gateway). Kosong = simulasi
# QRIS_IMAGE_URL=/assets/qris.png  # gambar QRIS milikmu (taruh di public/assets/)
# ADMIN_PHONE=081200000000
# ADMIN_PASSWORD=ganti-ini
# CRON_SECRET=string-acak-panjang
